# Copie para .env e preencha os segredos:  cp .env.example .env
# O arquivo .env NÃO é versionado.

# PostgreSQL (usado pelo docker-compose)
POSTGRES_DB=finance
POSTGRES_USER=finance
# gere com: openssl rand -base64 48
POSTGRES_PASSWORD=

# API
DB_URL=jdbc:postgresql://localhost:5432/finance
DB_USERNAME=finance
# gere com: openssl rand -base64 48
DB_PASSWORD=

# Segredo HMAC do JWT: mínimo de 32 caracteres.
# gere com: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION_MS=3600000
CORS_ALLOWED_ORIGINS=

# Blindagem de produção (perfil prod exige BFF_SHARED_SECRET >= 32 chars e desabilita /register + escrita demo na API)
BFF_SHARED_SECRET=
BFF_SECRET_REQUIRED=false
REGISTRATION_ENABLED=true
DEMO_API_READ_ONLY=false
DEMO_USER_EMAIL=empresa.demo@example.test

# Dashboard via Docker Compose (--profile fullstack)
DEMO_EMAIL=empresa.demo@example.test
DEMO_PASSWORD=
DEMO_MODE=readonly
TRUST_PROXY=true
NEXT_PUBLIC_SITE_URL=
